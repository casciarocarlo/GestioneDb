# Application Security
APP_ENV=development
APP_SECRET=your_32_byte_hex_secret_here

# Database Configuration (Main / User DB)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=

# Auth Database Configuration (Dedicated Auth DB)
AUTH_DB_HOST=localhost
AUTH_DB_USER=root
AUTH_DB_PASS=
AUTH_DB_NAME=db_gestionedb

# Default Initial Credentials
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=change_this_password

# OpenRouter AI Configuration
# Get your key at https://openrouter.ai/settings/keys
AI_API_KEY=your_openrouter_key_here
AI_MODEL=google/gemini-2.0-flash-001
